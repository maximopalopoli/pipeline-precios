POSTGRES_USER=sepa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sepa_pipeline

# Optional local-storage limits. All are disabled unless set to a positive
# number of days. Staging retention removes only terminal ingestion runs; raw
# retention removes only local ZIPs whose latest ingestion completed and whose
# verified archived copy is present in SEPA_ARCHIVE_DIR. With the default
# archive on the same disk that copy is a hard link, so raw retention frees no
# space; it only reclaims space when SEPA_ARCHIVE_DIR is on another disk.
#
# Fact retention keeps the ingested date plus the previous N days. It drops
# older daily fact partitions (and months left empty) together with their
# daily aggregates. Keep N >= 7 while the weekly KPI, Variaciones and Evolución
# views exist: they compare against the date seven days back. Enabling it on a
# database with a long history deletes those old aggregates in one transaction
# (about 1 M rows per stored day), so expect a slower first run.
# SEPA_FACT_RETENTION_DAYS=7
# SEPA_STAGING_RETENTION_DAYS=7
# SEPA_RAW_RETENTION_DAYS=30

# Folder that keeps every completed source ZIP by declared date and hash; it is
# the only history once the weekday URL is overwritten. Defaults to an "archive"
# folder inside the raw directory (hard links, no extra space on the same disk).
# Point it at another disk to survive a disk failure. `make restore-date` reads
# from it.
# SEPA_ARCHIVE_DIR=/mnt/backup/sepa-archive

# Every rejected row is counted per run, source and reason; rejected_rows keeps
# only this many example rows per run, source and reason (default 100, 0 keeps
# only the counts). Replay the archived ZIP to inspect every rejected row.
# SEPA_REJECTED_SAMPLE_ROWS=100

# Explicit bounds for a future local partial-ingestion run. These settings are
# validated as a contract now; they do not limit an ingestion until the bounded
# staging and publication flow is enabled. A chain key is id_comercio:id_bandera.
# SEPA_DEV_CHAIN_KEYS=123:1,456:2
# SEPA_DEV_MAX_PRODUCT_ROWS=5000

# Airflow (optional, used by docker-compose)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_SECRET_KEY=generate-a-random-secret-key
