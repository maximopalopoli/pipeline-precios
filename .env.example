POSTGRES_USER=sepa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sepa_pipeline

# Optional local-storage limits. All are disabled unless set to a positive
# number of days. Fact retention drops only whole expired monthly partitions;
# staging retention removes only terminal ingestion runs; raw retention removes
# only local ZIPs with a completed ingestion and no unresolved retry.
# SEPA_FACT_RETENTION_DAYS=90
# SEPA_STAGING_RETENTION_DAYS=7
# SEPA_RAW_RETENTION_DAYS=30

# Airflow (optional, used by docker-compose)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_SECRET_KEY=generate-a-random-secret-key
